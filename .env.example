# ==============================================================================
# Database Configuration (MySQL aaPanel di Host)
# ==============================================================================
# Dari container ke MySQL host aaPanel
DATABASE_URL=mysql://learnlangdb:YYdMBeZ8HbSCE6eP@host.docker.internal:3306/learnlangdb

# ==============================================================================
# Domain & NextAuth Configuration
# ==============================================================================
PORT=3000
NEXTAUTH_URL=https://learnlang.web.id
NEXTAUTH_SECRET=supersecretkey_please_change_in_production_123456789

# ==============================================================================
# Media & Analytics (Optional)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_GA_ID=

# ==============================================================================
# AI Provider Configuration (9Router Container)
# ==============================================================================
AI_PROVIDER=9router
NINEROUTER_BASE_URL=http://9router:20128/v1
NINEROUTER_PORT=20128
NINEROUTER_IMAGE=ghcr.io/decolua/9router:0.5.112
NINEROUTER_API_KEY=
NINEROUTER_MODEL=antigravity/gemini-3.5-flash-high
