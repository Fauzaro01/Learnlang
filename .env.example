# Database Configuration
DATABASE_URL=mysql://root:password@localhost:3306/learnlang

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secure-nextauth-secret-here

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=

# ==============================================================================
# AI Provider Configuration (9Router)
# ==============================================================================
# AI_PROVIDER: '9router' (default) atau 'ollama' (fallback legacy)
AI_PROVIDER=9router

# 9Router Base URL (default lokal: http://localhost:20128/v1)
NINEROUTER_BASE_URL=http://localhost:20128/v1

# 9Router API Key (didapatkan dari dashboard 9Router: http://localhost:20128)
# Opsional/kosongkan jika 9Router berjalan di mesin lokal tanpa REQUIRE_API_KEY
NINEROUTER_API_KEY=your-9router-api-key-here

# 9Router Model Identifier
# Format: <provider-alias>/<model-id> atau nama combo routing 9Router
# Contoh: antigravity/gemini-3.5-flash-high, openai/gpt-4o-mini, anthropic/claude-3-5-sonnet
NINEROUTER_MODEL=antigravity/gemini-3.5-flash-high

# ==============================================================================
# Legacy Ollama Configuration (hanya aktif jika AI_PROVIDER=ollama)
# ==============================================================================
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:1.5b
