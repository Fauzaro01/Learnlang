# Environment Variables Template
PORT=3000
NODE_ENV=production

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=supersecretkey_please_change_in_production_123456789

# Database (MySQL)
# Untuk Docker Compose: mysql://learnlang:learnlang123@mysql:3306/learnlang
# Untuk Local host: mysql://root:password@localhost:3306/learnlang
DATABASE_URL="mysql://learnlang:learnlang123@mysql:3306/learnlang"

# MySQL Root & User credentials (Digunakan oleh docker-compose.yml)
MYSQL_ROOT_PASSWORD=rootsecret
MYSQL_DATABASE=learnlang
MYSQL_USER=learnlang
MYSQL_PASSWORD=learnlang123
MYSQL_PORT=3306

# AI / Ollama Configuration (Opsional)
# Jika pakai Ollama di Docker (profile ai): http://ollama:11434
# Jika pakai Ollama lokal di host: http://host.docker.internal:11434
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_MODEL="qwen2.5:1.5b"
