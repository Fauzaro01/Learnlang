# ==============================================================================
# Database Configuration (MySQL aaPanel di Host)
# ==============================================================================
# Di dalam container Docker, host diarahkan ke 'host.docker.internal'
DATABASE_URL=mysql://learnlangdb:YYdMBeZ8HbSCE6eP@host.docker.internal:3306/learnlangdb

# ==============================================================================
# NextAuth Configuration
# ==============================================================================
PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=supersecretkey_please_change_in_production_123456789

# ==============================================================================
# Media & Analytics (Optional)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_GA_ID=

# ==============================================================================
# AI Provider Configuration (9Router Container)
# ==============================================================================
# AI_PROVIDER: '9router' (default) atau 'ollama'
AI_PROVIDER=9router

# URL internal antar-container Docker:
NINEROUTER_BASE_URL=http://9router:20128/v1
NINEROUTER_PORT=20128
NINEROUTER_IMAGE=ghcr.io/fmaclen/9router:latest

# 9Router API Key (opsional jika 9router lokal tanpa autentikasi)
NINEROUTER_API_KEY=

# Model default di 9Router
NINEROUTER_MODEL=antigravity/gemini-3.5-flash-high
